{
  "name": "merchantportal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build:static && npm run upload:s3",
    "upload:s3": "aws s3 sync out/ s3://dashboard.glidexpay.com --delete --cache-control max-age=31536000,public",
    "deploy:prod": "npm run build:static && npm run upload:s3 && npm run invalidate:cloudfront",
    "invalidate:cloudfront": "aws cloudfront create-invalidation --distribution-id YOUR_DISTRIBUTION_ID --paths '/*'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@mui/material": "^7.1.0",
    "@reduxjs/toolkit": "^2.7.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.482.0",
    "next": "15.2.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha-enterprise": "^1.0.3",
    "react-hook-form": "^7.56.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "reactstrap": "^9.2.3",
    "recharts": "^2.15.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha-enterprise": "^1.0.3",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "tailwindcss": "^4.1.6",
    "typescript": "^5"
  }
}
